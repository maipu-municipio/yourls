# Copiar a .env y completar. Nunca commitear el .env real.

# ---- Puerto / red ----
# IP local del host donde corre este contenedor (LAN/VPN que comparte con el host de cloudflared).
# Usar la IP real (ej: 10.0.0.5) en vez de 0.0.0.0 si el host tiene también una interfaz pública.
YOURLS_BIND_ADDRESS=0.0.0.0
YOURLS_PORT=8082

# ---- YOURLS ----
# URL pública final (la que resuelve el Cloudflare Tunnel), sin barra final.
YOURLS_SITE=https://yourls.maipu.gob.ar
YOURLS_LANG=
YOURLS_UNIQUE_URLS=true
YOURLS_PRIVATE=true
# Generar con: openssl rand -hex 32
YOURLS_COOKIEKEY=change-me
YOURLS_URL_CONVERT=36
YOURLS_DEBUG=false

# Usuarios admin (pares numerados, YOURLS los hashea solos en el primer arranque)
YOURLS_USER_1=admin
YOURLS_PASS_1=Malvinas2020$

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=lG6reBHCci6L
YOURLS_DB_NAME=yourls
YOURLS_DB_USER=yourls
YOURLS_DB_PASS=FUbnWqCNyA2c
# Host "db" = nombre del servicio en docker-compose.yml, no cambiar salvo que cambies el compose
YOURLS_DB_HOST=db
YOURLS_DB_PREFIX=yourls_
